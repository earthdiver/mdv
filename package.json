{
  "name": "mdv-desktop-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bundled, offline Markdown renderer for the MDV Windows desktop application",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "test": "node --test renderer/test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
